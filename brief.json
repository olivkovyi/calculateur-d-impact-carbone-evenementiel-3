    "document_html": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Calculateur d&#x27;Impact Carbone Événementiel | Votre Événement, Pas à Pas</title>\n    <meta name=\"description\" content=\"Estimez l\">\n    <style>\n        :root {\n            --color-primary: #38b2ac; /* Teal */\n            --color-secondary: #f6ad55; /* Orange */\n            --color-accent: #e53e3e; /* Red */\n            --color-text: #2d3748; /* Dark Grey */\n            --color-bg-light: #f7fafc; /* Light Grey */\n            --color-bg-dark: #1a202c; /* Very Dark Grey */\n            --color-border: #cbd5e0; /* Grey Border */\n            --font-family-sans: \"Helvetica Neue\", Arial, sans-serif;\n            --font-family-mono: \"SFMono-Regular\", Consolas, \"Liberation Mono\", Menlo, Courier, monospace;\n        }\n\n        body {\n            font-family: var(--font-family-sans);\n            line-height: 1.6;\n            margin: 0;\n            padding: 0;\n            background-color: var(--color-bg-light);\n            color: var(--color-text);\n            display: flex;\n            flex-direction: column;\n            min-height: 100vh;\n            overflow-x: hidden;\n        }\n\n        header {\n            background-color: var(--color-primary);\n            color: white;\n            padding: 1.5rem 1rem;\n            text-align: center;\n            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\n            position: relative;\n            z-index: 10;\n        }\n\n        header h1 {\n            margin: 0;\n            font-size: 2.5rem;\n            line-height: 1.2;\n        }\n\n        header p {\n            font-size: 1.2rem;\n            max-width: 800px;\n            margin: 1rem auto 0;\n        }\n\n        .container {\n            max-width: 960px;\n            margin: 2rem auto;\n            padding: 0 1rem;\n            flex-grow: 1;\n        }\n\n        .section {\n            background-color: white;\n            padding: 2rem;\n            margin-bottom: 2rem;\n            border-radius: 8px;\n            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);\n            border-left: 8px solid var(--color-primary);\n        }\n\n        .section.alt {\n            border-left: 8px solid var(--color-secondary);\n        }\n\n        h2 {\n            color: var(--color-primary);\n            font-size: 2rem;\n            margin-top: 0;\n            margin-bottom: 1.5rem;\n            border-bottom: 2px solid var(--color-border);\n            padding-bottom: 0.5rem;\n        }\n\n        h3 {\n            color: var(--color-text);\n            font-size: 1.5rem;\n            margin-top: 1.5rem;\n            margin-bottom: 1rem;\n        }\n\n        label {\n            display: block;\n            margin-bottom: 0.5rem;\n            font-weight: bold;\n            color: var(--color-text);\n        }\n\n        input[type=\"number\"],\n        select {\n            width: calc(100% - 20px);\n            padding: 10px;\n            margin-bottom: 1rem;\n            border: 1px solid var(--color-border);\n            border-radius: 4px;\n            font-size: 1rem;\n            font-family: var(--font-family-mono);\n            box-sizing: border-box;\n        }\n\n        input[type=\"radio\"] {\n            margin-right: 0.5rem;\n        }\n\n        .radio-group {\n            margin-bottom: 1rem;\n        }\n\n        .radio-group label {\n            display: inline-block;\n            margin-right: 1rem;\n            font-weight: normal;\n        }\n\n        button {\n            background-color: var(--color-primary);\n            color: white;\n            padding: 12px 25px;\n            border: none;\n            border-radius: 4px;\n            font-size: 1.1rem;\n            cursor: pointer;\n            transition: background-color 0.3s ease;\n            font-weight: bold;\n            margin-top: 1rem;\n        }\n\n        button:hover {\n            background-color: #2c9797;\n        }\n\n        #tool-result {\n            margin-top: 2rem;\n            padding: 1.5rem;\n            background-color: var(--color-bg-light);\n            border: 2px dashed var(--color-primary);\n            border-radius: 8px;\n            min-height: 100px;\n            font-size: 1.1rem;\n            line-height: 1.8;\n            color: var(--color-text);\n        }\n\n        #tool-result h3 {\n            color: var(--color-primary);\n            border-bottom: 1px solid var(--color-border);\n            padding-bottom: 0.5rem;\n        }\n\n        .result-item {\n            margin-bottom: 0.8rem;\n        }\n\n        .result-item strong {\n            color: var(--color-secondary);\n        }\n\n        .seo-section {\n            background-color: var(--color-bg-dark);\n            color: white;\n            padding: 3rem 1rem;\n            text-align: center;\n            margin-top: 2rem;\n        }\n\n        .seo-section h2 {\n            color: var(--color-secondary);\n            margin-bottom: 1.5rem;\n            border-bottom: 2px solid var(--color-primary);\n            padding-bottom: 0.5rem;\n            display: inline-block;\n        }\n\n        .seo-section p {\n            max-width: 800px;\n            margin: 0 auto 1.5rem;\n            line-height: 1.7;\n        }\n\n        .seo-section ul {\n            list-style: none;\n            padding: 0;\n            max-width: 800px;\n            margin: 0 auto;\n            text-align: left;\n        }\n\n        .seo-section ul li {\n            background-color: rgba(255, 255, 255, 0.1);\n            margin-bottom: 0.8rem;\n            padding: 0.8rem 1.2rem;\n            border-radius: 4px;\n            display: flex;\n            align-items: center;\n        }\n\n        .seo-section ul li::before {\n            content: \"✨\";\n            margin-right: 0.8rem;\n            font-size: 1.2rem;\n        }\n\n        footer {\n            background-color: var(--color-text);\n            color: white;\n            text-align: center;\n            padding: 1.5rem 1rem;\n            margin-top: auto;\n            font-size: 0.9rem;\n        }\n    </style>\n    <meta name=\"robots\" content=\"index, follow\">\n    <link rel=\"canonical\" href=\"https://calculateur-d-impact-carbone-evenementiel-3.onrender.com\">\n    <meta property=\"og:title\" content=\"Calculateur d&#x27;Impact Carbone Événementiel\">\n    <meta property=\"og:description\" content=\"Estimez l\">\n    <meta property=\"og:url\" content=\"https://calculateur-d-impact-carbone-evenementiel-3.onrender.com\">\n    <meta property=\"og:type\" content=\"website\">\n    <script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"WebApplication\", \"name\": \"Calculateur d'Impact Carbone Événementiel\", \"description\": \"Estimez l\", \"url\": \"https://calculateur-d-impact-carbone-evenementiel-3.onrender.com\", \"applicationCategory\": \"UtilityApplication\", \"operatingSystem\": \"Web Browser\"}</script>\n</head>\n<body data-site-slug=\"calculateur-d-impact-carbone-evenementiel-3\" data-runtime-mode=\"generic_calculator\">\n    <header>\n        <h1>Calculateur d'Impact Carbone Événementiel</h1>\n        <p>Estimez l'empreinte carbone de vos événements (mariages, conférences, festivals) et obtenez des pistes d'amélioration pour un futur plus vert.</p>\n    </header>\n\n    <main class=\"container\">\n        <section class=\"section\">\n            <h2>Votre Événement, Pas à Pas</h2>\n            <p>Notre calculateur vous guide pour évaluer l'impact environnemental de votre projet. Ensemble, construisons des événements responsables !</p>\n\n            <form id=\"tool-form\">\n                <div class=\"step\">\n                    <h3>1. Détails Généraux de l'Événement</h3>\n                    <label for=\"type_evenement\">Type d'événement :</label>\n                    <select id=\"type_evenement\" name=\"type_evenement\">\n                        <option value=\"conference\">Conférence / Séminaire</option>\n                        <option value=\"mariage\">Mariage</option>\n                        <option value=\"festival\">Festival / Concert</option>\n                        <option value=\"sportif\">Événement Sportif</option>\n                        <option value=\"prive\">Réception Privée</option>\n                        <option value=\"autre\">Autre</option>\n                    </select>\n\n                    <label for=\"nombre_participants\">Nombre estimé de participants :</label>\n                    <input type=\"number\" id=\"nombre_participants\" name=\"nombre_participants\" min=\"1\" value=\"100\" required>\n\n                    <label for=\"duree_jours\">Durée de l'événement (jours) :</label>\n                    <input type=\"number\" id=\"duree_jours\" name=\"duree_jours\" min=\"1\" value=\"1\" required>\n                </div>\n\n                <div class=\"step alt\">\n                    <h3>2. Transport des Participants</h3>\n                    <p>Estimation des modes de transport pour les participants. Les moyennes nationales sont utilisées pour les émissions.</p>\n                    <label for=\"pct_avion\">Pourcentage venant en avion (%) :</label>\n                    <input type=\"number\" id=\"pct_avion\" name=\"pct_avion\" min=\"0\" max=\"100\" value=\"10\" required>\n\n                    <label for=\"pct_train\">Pourcentage venant en train (%) :</label>\n                    <input type=\"number\" id=\"pct_train\" name=\"pct_train\" min=\"0\" max=\"100\" value=\"20\" required>\n\n                    <label for=\"pct_voiture\">Pourcentage venant en voiture (%) :</label>\n                    <input type=\"number\" id=\"pct_voiture\" name=\"pct_voiture\" min=\"0\" max=\"100\" value=\"50\" required>\n                    \n                    <label for=\"pct_local\">Pourcentage venant localement (pieds/vélo/transport en commun) (%) :</label>\n                    <input type=\"number\" id=\"pct_local\" name=\"pct_local\" min=\"0\" max=\"100\" value=\"20\" required>\n                </div>\n\n                <div class=\"step\">\n                    <h3>3. Consommation Énergétique du Lieu</h3>\n                    <p>Évaluez l'impact lié à l'énergie de votre site (éclairage, chauffage/clim...).</p>\n                    <label for=\"surface_m2\">Surface occupée par l'événement (m²) :</label>\n                    <input type=\"number\" id=\"surface_m2\" name=\"surface_m2\" min=\"10\" value=\"200\" required>\n\n                    <label for=\"energie_type\">Source d'énergie principale :</label>\n                    <select id=\"energie_type\" name=\"energie_type\">\n                        <option value=\"reseau_france\">Réseau national (France)</option>\n                        <option value=\"renouvelable\">100% Renouvelable (certifié)</option>\n                        <option value=\"generateur_diesel\">Générateur Diesel</option>\n                    </select>\n                </div>\n\n                <div class=\"step alt\">\n                    <h3>4. Restauration et Gestion des Déchets</h3>\n                    <p>L'alimentation et les déchets ont un rôle clé dans l'empreinte.</p>\n                    <label for=\"repas_servis\">Nombre de repas servis :</label>\n                    <input type=\"number\" id=\"repas_servis\" name=\"repas_servis\" min=\"0\" value=\"200\" required>\n\n                    <label for=\"options_repas\">Options de repas :</label>\n                    <select id=\"options_repas\" name=\"options_repas\">\n                        <option value=\"classique\">Majorité viande/poisson</option>\n                        <option value=\"vegetarien\">Majorité végétarien</option>\n                        <option value=\"local_bio\">Local & Bio</option>\n                    </select>\n\n                    <label for=\"dechets_kg\">Déchets générés (estimation en kg) :</label>\n                    <input type=\"number\" id=\"dechets_kg\" name=\"dechets_kg\" min=\"0\" value=\"50\" required>\n                </div>\n\n                <button type=\"submit\" id=\"tool-submit\">Calculer l'Empreinte Carbone</button>\n            </form>\n\n            <div id=\"tool-result\">\n                <h3 id=\"result-headline\">Votre Empreinte Estimée :</h3>\n                <p>Les résultats de votre événement apparaîtront ici après le calcul. Chaque pas compte !</p>\n            </div>\n        </section>\n\n        <section class=\"section alt\">\n            <h2>Pourquoi Calculer ?</h2>\n            <p>Dans un monde où chaque action a un impact, mesurer l'empreinte carbone de vos événements n'est pas seulement une tendance, c'est une nécessité. Cela vous permet d'identifier les postes d'émissions les plus importants et d'agir concrètement pour les réduire. Que vous soyez organisateur de mariages éco-responsables, planificateur de conférences ou responsable RSE, cet outil est votre allié.</p>\n            <p>Notre approche \"Signal Solaire\" combine une vision optimiste avec des données solides pour vous donner une direction claire vers des pratiques plus durables.</p>\n        </section>\n    </main>\n\n    <div class=\"seo-section\">\n        <h2>Optimiser l'Impact de Vos Événements</h2>\n        <p>Cherchez-vous à organiser un événement plus respectueux de l'environnement ? Notre calculateur d'empreinte carbone est l'outil qu'il vous faut pour une démarche RSE réussie. Que ce soit pour un <strong>mariage éco-responsable</strong>, une <strong>conférence verte</strong> ou un <strong>festival durable</strong>, nous vous aidons à chaque étape.</p>\n        <p>Découvrez comment réduire vos émissions de CO2 liées au transport, à l'énergie, à la restauration et à la gestion des déchets. Un événement réussi est aussi un événement qui préserve notre planète.</p>\n        <ul>\n            <li>Calculateur CO2 événementiel gratuit</li>\n            <li>Estimation empreinte carbone mariage</li>\n            <li>Bilan carbone conférence durable</li>\n            <li>Organiser un événement zéro déchet</li>\n            <li>Certification événement éco-responsable</li>\n            <li>Réduction impact environnemental festival</li>\n            <li>Outil RSE organisateur événement</li>\n        </ul>\n    </div>\n\n    <footer>\n        <p>&copy; 2024 Signal Solaire. Tous droits réservés.</p>\n    </footer>\n\n    <script>\n        document.getElementById('tool-form').addEventListener('submit', function(event) {\n            event.preventDefault();\n\n            const nombreParticipants = parseFloat(document.getElementById('nombre_participants').value);\n            const dureeJours = parseFloat(document.getElementById('duree_jours').value);\n            const pctAvion = parseFloat(document.getElementById('pct_avion').value);\n            const pctTrain = parseFloat(document.getElementById('pct_train').value);\n            const pctVoiture = parseFloat(document.getElementById('pct_voiture').value);\n            const pctLocal = parseFloat(document.getElementById('pct_local').value);\n            const surfaceM2 = parseFloat(document.getElementById('surface_m2').value);\n            const energieType = document.getElementById('energie_type').value;\n            const repasServis = parseFloat(document.getElementById('repas_servis').value);\n            const optionsRepas = document.getElementById('options_repas').value;\n            const dechetsKg = parseFloat(document.getElementById('dechets_kg').value);\n\n            let totalEmissions = 0;\n            let detailEmissions = {};\n\n            // 1. Transport des participants (en kg CO2e par personne par km, estimations moyennes)\n            // Distances moyennes pour un événement en France (simplifié pour le calculateur)\n            const distAvion = 500; // km, pour des vols courts\n            const distTrain = 200; // km\n            const distVoiture = 100; // km\n\n            // Facteurs d'émissions (kg CO2e par personne par km)\n            const feAvion = 0.15; // court-courrier\n            const feTrain = 0.004; // TGV\n            const feVoiture = 0.15; // voiture moyenne, partagée\n            // feLocal = 0;\n\n            const participantsAvion = nombreParticipants * (pctAvion / 100);\n            const participantsTrain = nombreParticipants * (pctTrain / 100);\n            const participantsVoiture = nombreParticipants * (pctVoiture / 100);\n\n            const emissionsAvion = participantsAvion * distAvion * feAvion;\n            const emissionsTrain = participantsTrain * distTrain * feTrain;\n            const emissionsVoiture = participantsVoiture * distVoiture * feVoiture;\n\n            detailEmissions['Transport (Avion)'] = emissionsAvion;\n            detailEmissions['Transport (Train)'] = emissionsTrain;\n            detailEmissions['Transport (Voiture)'] = emissionsVoiture;\n            \n            totalEmissions += emissionsAvion + emissionsTrain + emissionsVoiture;\n\n            // 2. Consommation Énergétique du Lieu (kg CO2e par m² par jour)\n            let feEnergie;\n            switch (energieType) {\n                case 'reseau_france':\n                    feEnergie = 0.05; // kg CO2e/kWh, mix électrique français 2023 (très bas)\n                    break;\n                case 'renouvelable':\n                    feEnergie = 0.005; // Négligeable mais pas zéro pour le cycle de vie\n                    break;\n                case 'generateur_diesel':\n                    feEnergie = 0.7; // kg CO2e/kWh (estimé pour un générateur)\n                    break;\n            }\n            // Consommation énergétique moyenne par m² par jour (très simplifié)\n            const consoMoyenneKWhM2Jour = 0.5; // kWh/m²/jour\n\n            const emissionsEnergie = surfaceM2 * dureeJours * consoMoyenneKWhM2Jour * feEnergie;\n            detailEmissions['Énergie du lieu'] = emissionsEnergie;\n            totalEmissions += emissionsEnergie;\n\n            // 3. Restauration (kg CO2e par repas)\n            let feRepas;\n            switch (optionsRepas) {\n                case 'classique':\n                    feRepas = 3; // kg CO2e/repas (viande/poisson)\n                    break;\n                case 'vegetarien':\n                    feRepas = 1.5; // kg CO2e/repas\n                    break;\n                case 'local_bio':\n                    feRepas = 1; // kg CO2e/repas (impact réduit)\n                    break;\n            }\n            const emissionsRestauration = repasServis * feRepas;\n            detailEmissions['Restauration'] = emissionsRestauration;\n            totalEmissions += emissionsRestauration;\n\n            // 4. Déchets (kg CO2e par kg de déchet)\n            const feDechet = 0.2; // kg CO2e/kg (moyenne, peut varier selon traitement)\n            const emissionsDechets = dechetsKg * feDechet;\n            detailEmissions['Déchets'] = emissionsDechets;\n            totalEmissions += emissionsDechets;\n\n            // Afficher les résultats\n            const resultDiv = document.getElementById('tool-result');\n            let resultHTML = '<h3>Votre Empreinte Estimée :</h3>';\n            resultHTML += `<p class=\"result-item\"><strong>Total estimé :</strong> ${totalEmissions.toFixed(2)} kg CO2e</p>`;\n            resultHTML += '<p><strong>Détail par poste :</strong></p><ul>';\n            for (const category in detailEmissions) {\n                resultHTML += `<li class=\"result-item\">${category} : ${detailEmissions[category].toFixed(2)} kg CO2e</li>`;\n            }\n            resultHTML += '</ul><p><strong>Pistes d\\'amélioration :</strong></p><ul>';\n\n            // Pistes d'amélioration dynamiques\n            if (emissionsAvion > totalEmissions * 0.1) {\n                resultHTML += '<li>Encouragez les transports alternatifs à l\\'avion pour les participants éloignés.</li>';\n            }\n            if (emissionsVoiture > totalEmissions * 0.15) {\n                resultHTML += '<li>Mettez en place un système de covoiturage ou des navettes depuis les gares/parkings.</li>';\n            }\n            if (energieType === 'generateur_diesel') {\n                resultHTML += '<li>Explorez des solutions d\\'alimentation électrique renouvelables ou raccordez-vous au réseau.</li>';\n            }\n            if (optionsRepas === 'classique' && repasServis > 0) {\n                resultHTML += '<li>Proposez davantage d\\'options végétariennes ou privilégiez les produits locaux et de saison.</li>';\n            }\n            if (dechetsKg > 50 && nombreParticipants > 0) { // Arbitraire, à ajuster\n                resultHTML += '<li>Améliorez le tri des déchets et réduisez le gaspillage alimentaire.</li>';\n            }\n            if (totalEmissions > 1000) { // Seuil arbitraire pour un événement moyen\n                resultHTML += '<li>Envisagez la compensation carbone pour les émissions incompressibles.</li>';\n            }\n            if (resultHTML.endsWith('<ul>')) { // Si aucune piste spécifique n'a été ajoutée\n                resultHTML += '<li>Chaque petite action compte ! Continuez à explorer des solutions durables pour tous les aspects de votre événement.</li>';\n            }\n            resultHTML += '</ul>';\n\n            resultDiv.innerHTML = resultHTML;\n        });\n    </script>\n<div id=\"qa-smoke-result\" hidden></div>\n<script id=\"farmbuilder-affiliate-helper\">\n(function () {\n  window.__UTILITY_AFFILIATE_MAP = window.__UTILITY_AFFILIATE_MAP || {};\n  document.addEventListener(\"click\", function (event) {\n    const target = event.target.closest(\"[data-affiliate-slot]\");\n    if (!target) return;\n    const slot = target.getAttribute(\"data-affiliate-slot\");\n    const href = window.__UTILITY_AFFILIATE_MAP[slot];\n    if (!href) return;\n    if (target.tagName && target.tagName.toLowerCase() === \"a\") {\n      target.setAttribute(\"href\", href);\n      target.setAttribute(\"rel\", \"nofollow sponsored noopener noreferrer\");\n      return;\n    }\n    event.preventDefault();\n    window.open(href, \"_blank\", \"noopener\");\n  }, true);\n})();\n</script>\n<script id=\"farmbuilder-functional-qa\">\n(function () {\n  function marker() {\n    let node = document.getElementById(\"qa-smoke-result\");\n    if (node) return node;\n    node = document.createElement(\"div\");\n    node.id = \"qa-smoke-result\";\n    node.hidden = true;\n    document.body.appendChild(node);\n    return node;\n  }\n\n  function normalize(text) {\n    return String(text || \"\").replace(/\\s+/g, \" \").trim();\n  }\n\n  function findForm() {\n    return document.getElementById(\"tool-form\") || document.querySelector(\"form\");\n  }\n\n  function findResult() {\n    return (\n      document.getElementById(\"tool-result\") ||\n      document.querySelector(\"[data-result]\") ||\n      document.querySelector(\".tool-result, .result-card, .result, .results, .output, .preview, .diagnostic, .analysis\")\n    );\n  }\n\n  function resultSignature(node) {\n    if (!node) return \"\";\n    const text = normalize(node.textContent);\n    const html = normalize(node.innerHTML).slice(0, 600);\n    return `${text}||${html}`;\n  }\n\n  function resultHeadline(node) {\n    if (!node) return \"\";\n    const heading = node.querySelector(\"h1, h2, h3, strong, b\");\n    return normalize(heading ? heading.textContent : \"\");\n  }\n\n  function sampleText(field) {\n    const key = `${field.id || \"\"} ${field.name || \"\"} ${field.placeholder || \"\"}`.toLowerCase();\n    if (/email/.test(key)) return \"bonjour@example.com\";\n    if (/url|site|website|lien/.test(key)) return \"https://example.com/offre-solaire\";\n    if (/phone|tel|mobile/.test(key)) return \"0612345678\";\n    if (/ville|city|localisation|location|region|departement|postal/.test(key)) return \"Paris\";\n    if (/orientation/.test(key)) return \"sud\";\n    if (/keyword|theme|topic|sujet|subject/.test(key)) return \"energie solaire domestique\";\n    if (/titre|title/.test(key)) return \"Simulateur solaire maison\";\n    if (/nom|name|project/.test(key)) return \"Projet Horizon\";\n    if (/description|notes|content|message/.test(key)) return \"Maison individuelle exposee sud avec toiture exploitable.\";\n    return field.placeholder || \"France\";\n  }\n\n  function sampleNumber(field) {\n    const key = `${field.id || \"\"} ${field.name || \"\"}`.toLowerCase();\n    if (/inclinaison|angle|slope/.test(key)) return \"30\";\n    if (/surface|size|m2|sqm/.test(key)) return \"28\";\n    if (/annee|year/.test(key)) return \"2024\";\n    if (/prix|price|budget|cost|amount|montant/.test(key)) return \"12000\";\n    const min = Number(field.min || \"\");\n    const max = Number(field.max || \"\");\n    if (Number.isFinite(min) && Number.isFinite(max) && max >= min) {\n      return String(Math.min(max, Math.max(min, min + Math.round((max - min) * 0.35))));\n    }\n    if (Number.isFinite(min)) return String(Math.max(min, 12));\n    if (Number.isFinite(max)) return String(Math.min(max, 12));\n    return field.value || \"12\";\n  }\n\n  function applySample(field) {\n    const tag = (field.tagName || \"\").toLowerCase();\n    const type = (field.type || \"\").toLowerCase();\n    if (field.disabled) return;\n    if (tag === \"select\") {\n      const option = Array.from(field.options || []).find((item) => item.value && !item.disabled) || field.options[0];\n      if (option) field.value = option.value;\n      return;\n    }\n    if (type === \"checkbox\") {\n      field.checked = true;\n      return;\n    }\n    if (type === \"radio\") {\n      field.checked = true;\n      return;\n    }\n    if (type === \"date\") {\n      field.value = \"2026-03-01\";\n      return;\n    }\n    if (type === \"email\") {\n      field.value = \"bonjour@example.com\";\n      return;\n    }\n    if (type === \"url\") {\n      field.value = \"https://example.com/offre-solaire\";\n      return;\n    }\n    if (type === \"tel\") {\n      field.value = \"0612345678\";\n      return;\n    }\n    if (type === \"color\") {\n      field.value = \"#2f855a\";\n      return;\n    }\n    if (type === \"number\" || type === \"range\") {\n      field.value = sampleNumber(field);\n      return;\n    }\n    field.value = sampleText(field);\n  }\n\n  function stamp(status, detail, headline, primary) {\n    const node = marker();\n    node.dataset.status = status;\n    node.dataset.mode = \"native-form\";\n    node.dataset.detail = detail || \"\";\n    node.dataset.headline = headline || \"\";\n    node.dataset.primary = primary || \"\";\n    node.dataset.viewport = window.innerWidth <= 640 ? \"mobile\" : \"desktop\";\n  }\n\n  function inspectResult(before, attemptsLeft) {\n    const result = findResult();\n    if (!result) {\n      stamp(\"fail\", \"La zone de resultat est introuvable.\", \"\");\n      return;\n    }\n    const after = resultSignature(result);\n    const text = normalize(result.textContent);\n    if (after && after !== before && text.length >= 24) {\n      const primary = result.querySelector(\"a[href], button[data-href], [data-primary-url]\") || document.querySelector(\"#tool-result a[href]\");\n      stamp(\"pass\", \"Le formulaire natif a mis a jour la zone de resultat.\", resultHeadline(result), primary ? (primary.getAttribute(\"href\") || primary.getAttribute(\"data-primary-url\") || \"\") : \"\");\n      return;\n    }\n    if (attemptsLeft > 0) {\n      window.setTimeout(function () {\n        inspectResult(before, attemptsLeft - 1);\n      }, 250);\n      return;\n    }\n    stamp(\"fail\", \"La zone de resultat n'a pas renvoye de contenu exploitable.\", resultHeadline(result));\n  }\n\n  function runSmoke() {\n    const params = new URLSearchParams(window.location.search);\n    if (params.get(\"__qa\") !== \"functional\") return;\n    const form = findForm();\n    if (!form) {\n      stamp(\"fail\", \"Le formulaire principal est introuvable.\", \"\");\n      return;\n    }\n    const result = findResult();\n    const before = resultSignature(result);\n    form.querySelectorAll(\"input, select, textarea\").forEach(applySample);\n    const blocker = function (event) {\n      event.preventDefault();\n    };\n    form.addEventListener(\"submit\", blocker, { capture: true, once: true });\n    form.dispatchEvent(new Event(\"submit\", { bubbles: true, cancelable: true }));\n    inspectResult(before, 6);\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", function () {\n      window.setTimeout(runSmoke, 60);\n    }, { once: true });\n  } else {\n    window.setTimeout(runSmoke, 60);\n  }\n})();\n</script>\n</body>\n</html>",
